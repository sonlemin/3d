#!/usr/bin/env bash
# Runs the local CI before each commit. Never skip it with --no-verify: fix what it found.
# Only runs when the commit touches game/ or tools/ci.sh (docs-only commits go straight through).
if git diff --cached --name-only | grep -q '^game/\|^tools/ci.sh'; then
	exec "$(git rev-parse --show-toplevel)/tools/ci.sh"
fi
