[gd_resource type="AudioBusLayout" format=3]

[sub_resource type="AudioEffectHighShelfFilter" id="AudioEffectHighShelfFilter_shadow"]
resource_name = "HighShelfFilter"
cutoff_hz = 2000.0

[sub_resource type="AudioEffectHighPassFilter" id="AudioEffectHighPassFilter_above"]
resource_name = "HighPassFilter"
cutoff_hz = 1000.0

[sub_resource type="AudioEffectReverb" id="AudioEffectReverb_above"]
resource_name = "Reverb"
room_size = 0.25
damping = 0.5
wet = 0.06
dry = 1.0
predelay_msec = 10.0

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_inside"]
resource_name = "LowPassFilter"
cutoff_hz = 650.0

[sub_resource type="AudioEffectReverb" id="AudioEffectReverb_inside"]
resource_name = "Reverb"
room_size = 0.08
damping = 0.95
wet = 0.45
dry = 1.0
predelay_msec = 3.0

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_below"]
resource_name = "LowPassFilter"
cutoff_hz = 2500.0

[sub_resource type="AudioEffectReverb" id="AudioEffectReverb_below"]
resource_name = "Reverb"
room_size = 1.0
damping = 0.15
wet = 0.7
dry = 0.6
predelay_msec = 120.0

[resource]
bus/1/name = &"Shadow"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("AudioEffectHighShelfFilter_shadow")
bus/1/effect/0/enabled = true
bus/2/name = &"Above"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Shadow"
bus/2/effect/0/effect = SubResource("AudioEffectHighPassFilter_above")
bus/2/effect/0/enabled = true
bus/2/effect/1/effect = SubResource("AudioEffectReverb_above")
bus/2/effect/1/enabled = true
bus/3/name = &"Inside"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Shadow"
bus/3/effect/0/effect = SubResource("AudioEffectLowPassFilter_inside")
bus/3/effect/0/enabled = true
bus/3/effect/1/effect = SubResource("AudioEffectReverb_inside")
bus/3/effect/1/enabled = true
bus/4/name = &"Below"
bus/4/solo = false
bus/4/mute = false
bus/4/bypass_fx = false
bus/4/volume_db = 0.0
bus/4/send = &"Shadow"
bus/4/effect/0/effect = SubResource("AudioEffectLowPassFilter_below")
bus/4/effect/0/enabled = true
bus/4/effect/1/effect = SubResource("AudioEffectReverb_below")
